<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="Game.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement name="topBar" class="top-bar frame">
            <ui:Button name="logoButton" focusable="false" class="logo-button">
                <ui:VisualElement class="icon icon-logo logo-icon" />
            </ui:Button>
            <ui:VisualElement class="turn-box" picking-mode="Ignore">
                <ui:Label text="Ход" class="turn-label" />
                <ui:Label name="turnValue" class="turn-value" />
            </ui:VisualElement>
            <ui:VisualElement name="stats" class="stats" picking-mode="Ignore" />
            <ui:VisualElement class="spacer" picking-mode="Ignore" />
            <ui:Button name="incidentChip" focusable="false" class="incident-chip hidden">
                <ui:VisualElement class="icon icon-info" picking-mode="Ignore" />
                <ui:Label name="incidentChipText" class="incident-chip-text" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="endTurnButton" focusable="false" class="end-turn">
                <ui:Label text="Следующий ход" class="end-turn-text" picking-mode="Ignore" />
                <ui:VisualElement class="icon icon-arrow" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="body" class="body">
            <ui:VisualElement name="map" class="map frame">
                <ui:VisualElement name="mapCanvas" class="map-canvas" />
                <ui:VisualElement name="mapLabels" class="map-labels" picking-mode="Ignore" />
                <ui:VisualElement class="map-header" picking-mode="Ignore">
                    <ui:Label text="ГАЛАКТИЧЕСКАЯ КАРТА" class="panel-title" picking-mode="Ignore" />
                    <ui:VisualElement name="sectorTabs" class="sector-tabs" />
                    <ui:Label name="eventLine" class="event-line" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="legend" class="legend" picking-mode="Ignore" />
                <ui:VisualElement name="probeBar" class="probe-bar hidden">
                    <ui:VisualElement name="probeTypes" class="segmented probe-types" />
                    <ui:VisualElement name="probeMissions" class="segmented probe-missions" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:Button name="probeDone" text="Готово" focusable="false" class="button probe-done" />
                </ui:VisualElement>
                <ui:Label name="probeInfo" class="probe-info hidden" picking-mode="Ignore" />
                <ui:VisualElement name="sectorLock" class="sector-lock frame hidden">
                    <ui:Label name="sectorLockTitle" class="title" />
                    <ui:Label name="sectorLockText" class="sector-lock-text" />
                    <ui:Button name="sectorLockBuy" focusable="false" class="character-pick sector-buy" />
                </ui:VisualElement>
                <ui:VisualElement class="map-tools">
                    <ui:Button name="centerButton" focusable="false" class="tool-button">
                        <ui:VisualElement class="icon icon-target" />
                    </ui:Button>
                    <ui:VisualElement class="zoom-box">
                        <ui:Button name="zoomOutButton" focusable="false" class="tool-button">
                            <ui:VisualElement class="icon icon-minus" />
                        </ui:Button>
                        <ui:Label name="zoomValue" text="100%" class="zoom-value" />
                        <ui:Button name="zoomInButton" focusable="false" class="tool-button">
                            <ui:VisualElement class="icon icon-plus" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Button name="probesButton" focusable="false" class="tool-button">
                        <ui:VisualElement class="icon icon-rocket" />
                        <ui:Label name="probesText" text="Зонды" class="tool-text" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="side" class="side frame">
                <ui:VisualElement name="tabs" class="tabs" />
                <ui:ScrollView name="sideScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="side-scroll" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="bottom" class="bottom">
            <ui:VisualElement class="bottom-panel market-panel frame">
                <ui:VisualElement class="panel-head">
                    <ui:Label text="Рынок" class="panel-title-small" />
                    <ui:Label text="(за ед.)" class="panel-note" />
                </ui:VisualElement>
                <ui:VisualElement name="marketCards" class="market-cards" />
            </ui:VisualElement>
            <ui:VisualElement class="bottom-panel events-panel frame">
                <ui:VisualElement class="panel-head">
                    <ui:Label text="События" class="panel-title-small" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="journalButton" focusable="false" class="small-button">
                        <ui:Label text="Журнал событий" picking-mode="Ignore" />
                        <ui:VisualElement class="icon icon-arrow" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="eventsList" class="events-list" />
            </ui:VisualElement>
            <ui:VisualElement class="bottom-panel actions-panel frame">
                <ui:VisualElement class="panel-head">
                    <ui:Label text="Действия" class="panel-title-small" />
                    <ui:Label text="в этом ходу" class="panel-note" />
                    <ui:VisualElement class="spacer" />
                    <ui:Label name="actionsCount" class="actions-count" />
                </ui:VisualElement>
                <ui:ScrollView name="actionsList" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="actions-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="menu" class="menu-popup frame hidden">
            <ui:Button name="newGameButton" text="Новая игра" focusable="false" class="button" />
            <ui:Button name="saveButton" text="Сохранить" focusable="false" class="button" />
            <ui:Button name="loadButton" text="Загрузить" focusable="false" class="button" />
            <ui:Button name="showcaseButton" text="Витрина планет (F2)" focusable="false" class="button" />
        </ui:VisualElement>
        <ui:VisualElement name="journal" class="overlay hidden">
            <ui:VisualElement class="journal-card frame">
                <ui:VisualElement class="panel-head">
                    <ui:Label text="Журнал событий" class="panel-title-small" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="journalClose" focusable="false" class="small-button">
                        <ui:Label text="Закрыть" picking-mode="Ignore" />
                        <ui:VisualElement class="icon icon-close" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="journalList" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="journal-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rivals" class="overlay hidden">
            <ui:VisualElement class="rivals-card frame">
                <ui:Label name="rivalsTitle" class="title" />
                <ui:VisualElement name="rivalsList" />
                <ui:VisualElement class="spacer" />
                <ui:VisualElement class="bar wide">
                    <ui:VisualElement name="rivalsProgress" class="bar-fill rivals-fill" />
                </ui:VisualElement>
                <ui:Label text="Клик или пробел — пропустить" class="small" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="start" class="overlay start-overlay hidden">
            <ui:VisualElement class="start-card frame">
                <ui:Label text="Новая корпорация" class="title" />
                <ui:Label text="Кто сядет в кресло директора? От выбора зависят навыки, деньги и репутация на старте. Остальное — дело наживы." class="start-subtitle" />
                <ui:VisualElement name="startCharacters" class="start-characters" />
                <ui:VisualElement class="start-footer">
                    <ui:Label text="Навыки от 1 до 5, средний — 3: переговоры — покупка и продажа планет, сделки с жителями; геология — шахты и зонды; грязные дела — слухи и подкуп; работа с людьми — праздники, школы, учёба." class="small start-note" />
                    <ui:Button name="startLoadButton" text="Загрузить" focusable="false" class="button start-cancel hidden" />
                    <ui:Button name="continueButton" text="Продолжить партию" focusable="false" class="button start-cancel start-continue hidden" />
                    <ui:Button name="startCancel" text="Вернуться к партии" focusable="false" class="button start-cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="alerts" class="overlay hidden">
            <ui:VisualElement class="alerts-card frame">
                <ui:Label name="alertsTitle" text="Важное за ход" class="title alerts-title" />
                <ui:ScrollView name="alertsList" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="alerts-list" />
                <ui:VisualElement class="alerts-footer">
                    <ui:Label text="Всё это есть и в журнале событий." class="small alerts-note" />
                    <ui:Button name="alertsOk" text="Понятно" focusable="false" class="alerts-ok" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="show" class="overlay hidden">
            <ui:VisualElement class="alerts-card show-card frame">
                <ui:Label name="showTitle" class="title alerts-title" />
                <ui:ScrollView name="showBody" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="alerts-list" />
                <ui:VisualElement class="alerts-footer">
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="showOk" text="Понятно" focusable="false" class="alerts-ok" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="season" class="overlay season-overlay hidden">
            <ui:VisualElement name="seasonBody" class="season-card frame" />
        </ui:VisualElement>
        <ui:VisualElement name="incident" class="overlay hidden">
            <ui:VisualElement name="incidentBody" class="alerts-card incident-card frame" />
        </ui:VisualElement>
        <ui:VisualElement name="saves" class="overlay hidden">
            <ui:VisualElement class="journal-card saves-card frame">
                <ui:VisualElement class="panel-head">
                    <ui:Label text="Сохранённые партии" class="panel-title-small" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="savesClose" focusable="false" class="small-button">
                        <ui:Label text="Закрыть" picking-mode="Ignore" />
                        <ui:VisualElement class="icon icon-close" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView name="savesList" mode="Vertical" horizontal-scroller-visibility="Hidden" touch-scroll-type="Clamped" class="journal-list" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="tooltip" class="tooltip hidden" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
