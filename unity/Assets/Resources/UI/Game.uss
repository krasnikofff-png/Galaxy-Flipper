:root {
    --text: #e9ecf2;
    --text-dim: #b9c0cd;
    --muted: #8b93a3;
    --gold: #d6a24e;
    --orange: #f0a43a;
    --green: #58d68d;
    --red: #ff5d4f;
    --cyan: #5ec8ff;
    --card-bg: rgba(255, 255, 255, 0.035);
    --card-line: rgba(214, 162, 78, 0.18);
    --button-bg: rgba(20, 24, 34, 0.95);
    --button-hover: rgba(36, 40, 52, 0.98);
    --button-active: rgba(14, 16, 24, 1);
    --button-line: rgba(140, 118, 80, 0.55);
}

/* Каркас экрана */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 6px 8px 8px 8px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-Regular.ttf");
    font-size: 16px;
    color: var(--text);
}

.hidden {
    display: none;
}

.spacer {
    flex-grow: 1;
}

.icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.frame {
    --frame-fill: rgba(9, 12, 19, 0.94);
    --frame-line: rgba(92, 78, 52, 1);
    --frame-accent: rgba(220, 160, 70, 1);
    --frame-cut: 12;
}

/* Верхняя панель */

.top-bar {
    height: 60px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 6px;
    margin-bottom: 8px;
}

.logo-button {
    width: 44px;
    height: 44px;
    margin: 0 6px 0 0;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--gold);
}

.logo-button:hover {
    color: var(--orange);
}

.logo-icon {
    width: 26px;
    height: 26px;
}

.turn-box {
    flex-direction: row;
    align-items: center;
    padding-right: 14px;
    margin-right: 6px;
    border-right-width: 1px;
    border-color: rgba(92, 78, 52, 0.8);
}

.turn-label {
    font-size: 18px;
    color: var(--text-dim);
    margin-right: 6px;
}

.turn-value {
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.stats {
    flex-direction: row;
    flex-shrink: 1;
    overflow: hidden;
}

.stat {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 0 10px;
    border-right-width: 1px;
    border-color: rgba(92, 78, 52, 0.5);
}

.stat-icon {
    width: 20px;
    height: 20px;
    margin-right: 7px;
    color: var(--gold);
}

.stat-label {
    font-size: 11px;
    color: var(--muted);
}

.stat-value {
    font-size: 17px;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.stat.debt > .stat-icon,
.stat.debt .stat-value {
    color: var(--red);
}

.stat.capital > .stat-icon,
.stat.capital .stat-value {
    color: var(--green);
}

.stat.costs > .stat-icon,
.stat.costs .stat-value {
    color: var(--orange);
}

.stat.actions > .stat-icon {
    color: var(--text-dim);
}

.stat.reputation > .stat-icon {
    color: var(--cyan);
}

.stat.level > .stat-icon,
.stat.level .stat-value {
    color: var(--gold);
}

.stat.clickable:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Знаки уровней во вкладке «Развитие». */

.level-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.level-badge {
    width: 30px;
    height: 30px;
    margin-right: 10px;
}

.level-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.level-row-badge {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
}

.level-row-name {
    width: 130px;
    flex-shrink: 0;
    font-size: 14px;
    color: var(--text-dim);
}

.level-row-value {
    flex-shrink: 1;
    font-size: 13px;
    white-space: normal;
}

/* Полоска до следующего уровня корпорации: под названием уровня. */
.level-bar {
    height: 3px;
    margin-top: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 1px;
    overflow: hidden;
}

.level-fill {
    height: 100%;
    background-color: var(--gold);
}

.tabs {
    width: 118px;
    flex-shrink: 0;
    margin-right: 12px;
}

.tab {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin: 0 0 5px 0;
    padding: 0 9px;
    font-size: 13px;
    white-space: nowrap;
    color: var(--text-dim);
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: rgba(70, 74, 88, 0.9);
    border-radius: 3px;
    transition-duration: 0.12s;
}

.tab:hover {
    background-color: var(--button-hover);
    color: var(--text);
}

.tab.selected {
    color: var(--orange);
    border-color: var(--orange);
    background-color: rgba(70, 45, 15, 0.55);
}

.tab-icon {
    width: 16px;
    height: 16px;
    margin-right: 7px;
}

.end-turn {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 0;
    padding: 0 14px;
    background-color: rgba(120, 74, 20, 0.95);
    border-width: 1px;
    border-color: var(--orange);
    border-radius: 3px;
    color: #ffd08a;
    transition-duration: 0.12s;
}

.end-turn:hover {
    background-color: rgba(150, 94, 28, 1);
    color: #ffe2b0;
}

.end-turn-text {
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-right: 8px;
}

.menu-popup {
    position: absolute;
    left: 14px;
    top: 66px;
    width: 240px;
    padding: 10px;
}

/* Тело: карта и правая панель */

.body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    margin-bottom: 8px;
}

.map {
    flex-grow: 1;
    overflow: hidden;
    --frame-fill: rgba(0, 0, 0, 0);
}

.map-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-header {
    position: absolute;
    left: 22px;
    top: 14px;
}

.panel-title {
    font-size: 17px;
    letter-spacing: 2px;
    color: #d4d8e0;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.panel-subtitle {
    font-size: 13px;
    color: var(--muted);
}

.event-line {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    max-width: 520px;
    white-space: normal;
}

.event-line.active {
    color: #ffd27a;
    padding: 3px 8px;
    background-color: rgba(120, 80, 20, 0.45);
    border-width: 1px;
    border-color: rgba(240, 164, 58, 0.6);
    border-radius: 3px;
}

.map-label {
    position: absolute;
    width: 150px;
    align-items: center;
}

.map-label-name {
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

.map-label-price {
    flex-direction: row;
    align-items: center;
}

.map-label-price > .icon {
    width: 12px;
    height: 12px;
    margin-right: 3px;
    color: var(--orange);
}

.map-label-price > .label-text {
    font-size: 12px;
    color: var(--text-dim);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

.map-label-price.owned > .label-text {
    color: #ffc36b;
}

.legend {
    position: absolute;
    right: 16px;
    top: 14px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 560px;
    padding: 6px 12px;
    background-color: rgba(10, 13, 20, 0.85);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.7);
    border-radius: 3px;
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin: 1px 0 1px 14px;
    font-size: 12px;
    color: var(--text-dim);
}

.dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
}

.route-dash {
    width: 18px;
    height: 2px;
    margin-right: 6px;
    border-top-width: 2px;
    border-color: var(--orange);
}

.probe-bar {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 72px;
    height: 34px;
    flex-direction: row;
}

.probe-info {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 110px;
    padding: 4px 8px;
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
    background-color: rgba(10, 13, 20, 0.8);
    border-radius: 3px;
}

.probe-types {
    width: 420px;
}

.probe-bar .segment {
    font-size: 14px;
    padding-left: 4px;
    padding-right: 4px;
    white-space: nowrap;
}

.probe-missions {
    width: 300px;
    margin-left: 12px;
}

.probe-done {
    width: 90px;
}

.map-tools {
    position: absolute;
    left: 16px;
    bottom: 14px;
    flex-direction: row;
    align-items: center;
}

.tool-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 36px;
    margin: 0 8px 0 0;
    padding: 0 8px;
    color: var(--text-dim);
    background-color: rgba(12, 15, 22, 0.92);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.9);
    border-radius: 3px;
}

.tool-button:hover {
    color: var(--orange);
}

.tool-button.selected {
    color: var(--orange);
    border-color: var(--orange);
    background-color: rgba(70, 45, 15, 0.7);
}

.tool-button > .icon {
    width: 18px;
    height: 18px;
}

.tool-text {
    font-size: 14px;
    margin-left: 6px;
}

.zoom-box {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin-right: 8px;
    background-color: rgba(12, 15, 22, 0.92);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.9);
    border-radius: 3px;
}

.zoom-box > .tool-button {
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.zoom-value {
    width: 52px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.side {
    width: 650px;
    min-height: 0;
    flex-direction: row;
    margin-left: 8px;
    padding: 12px 8px 10px 12px;
}

.side-scroll {
    flex-grow: 1;
}

/* Нижние панели */

.bottom {
    height: 178px;
    flex-shrink: 0;
    flex-direction: row;
}

.bottom-panel {
    padding: 10px 14px 10px 16px;
    margin-right: 8px;
}

.market-panel {
    flex-grow: 1.6;
    flex-basis: 0;
}

.events-panel {
    flex-grow: 1;
    flex-basis: 0;
}

.actions-panel {
    width: 400px;
    margin-right: 0;
}

.panel-head {
    flex-direction: row;
    align-items: center;
    height: 26px;
    margin-bottom: 6px;
}

.panel-title-small {
    font-size: 17px;
    color: var(--orange);
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-right: 6px;
}

.panel-note {
    font-size: 13px;
    color: var(--muted);
}

.market-cards {
    flex-grow: 1;
    flex-direction: row;
}

.market-card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
    padding: 6px 7px 4px 7px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-line);
    border-radius: 3px;
}

.market-card:hover {
    border-color: rgba(240, 164, 58, 0.6);
}

.mc-head {
    flex-direction: row;
    align-items: center;
}

.mc-icon {
    width: 15px;
    height: 15px;
    margin-right: 4px;
}

.mc-name {
    font-size: 10.5px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.mc-price {
    font-size: 17px;
    margin-top: 3px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.mc-change {
    flex-direction: row;
    align-items: center;
}

.mc-change > .label-text {
    font-size: 13px;
}

.mc-change > .icon {
    width: 11px;
    height: 11px;
    margin-left: 4px;
}

.mc-change.up {
    color: var(--green);
}

.mc-change.down {
    color: var(--red);
}

.mc-change.flat {
    color: var(--muted);
}

.sparkline {
    flex-grow: 1;
    min-height: 16px;
    margin-top: 2px;
}

.small-button {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0;
    padding: 0 8px;
    font-size: 12px;
    color: var(--text-dim);
    background-color: rgba(18, 22, 30, 0.95);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.9);
    border-radius: 3px;
}

.small-button:hover {
    color: var(--orange);
}

.small-button > .icon {
    width: 13px;
    height: 13px;
    margin-left: 5px;
}

.events-list {
    flex-grow: 1;
    overflow: hidden;
}

.event-row {
    flex-direction: row;
    align-items: center;
    height: 29px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.event-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 10px;
    flex-shrink: 0;
    background-color: var(--muted);
}

.event-dot.good {
    background-color: var(--green);
}

.event-dot.bad {
    background-color: var(--red);
}

.event-dot.warn {
    background-color: var(--orange);
}

.event-dot.info {
    background-color: var(--cyan);
}

.event-turn {
    width: 44px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--muted);
}

.event-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.actions-count {
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.actions-list {
    flex-grow: 1;
}

.action-row {
    flex-direction: row;
    align-items: center;
    height: 27px;
    padding: 0 6px;
    margin-bottom: 2px;
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 3px;
}

.action-num {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 12px;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.08);
}

.action-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.action-row.free > .action-text {
    color: var(--muted);
}

.action-check {
    width: 20px;
    height: 20px;
    border-width: 1.5px;
    border-radius: 10px;
    border-color: rgba(255, 255, 255, 0.25);
}

.action-check.done {
    border-color: var(--green);
    color: var(--green);
    padding: 2px;
}

/* Окно планеты */

.planet-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.planet-title {
    font-size: 25px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-right: 12px;
    flex-shrink: 1;
}

.pill {
    font-size: 13px;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 3px 10px;
    border-width: 1px;
    border-radius: 10px;
    color: var(--text-dim);
    border-color: rgba(185, 192, 205, 0.5);
    background-color: rgba(185, 192, 205, 0.08);
}

.pill.mine {
    color: var(--green);
    border-color: rgba(88, 214, 141, 0.7);
    background-color: rgba(30, 110, 60, 0.3);
}

.pill.rival {
    color: var(--red);
    border-color: rgba(255, 93, 79, 0.7);
    background-color: rgba(120, 30, 24, 0.3);
}

.pill.found {
    color: #ffe066;
    border-color: rgba(255, 224, 102, 0.6);
    background-color: rgba(120, 100, 20, 0.25);
}

.coords {
    align-items: flex-end;
    flex-shrink: 0;
    margin-left: 8px;
}

.coords > .label-text {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
}

.portrait {
    height: 205px;
    margin-bottom: 10px;
    overflow: hidden;
    background-color: #05060c;
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.7);
}

/* Сводка планеты */

.summary {
    flex-direction: row;
    margin-bottom: 10px;
    padding: 4px 0;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-line);
    border-radius: 3px;
}

.summary-col {
    flex-grow: 1;
    flex-basis: 0;
    padding: 0 10px;
}

.summary-col.first {
    border-right-width: 1px;
    border-color: var(--card-line);
}

.fact {
    padding: 4px 0;
}

.fact-main {
    flex-direction: row;
    align-items: center;
}

.fact-icon {
    width: 15px;
    height: 15px;
    margin-right: 8px;
    color: var(--gold);
}

.fact-label {
    flex-grow: 1;
    font-size: 12px;
    color: var(--muted);
}

.fact-value {
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    -unity-text-align: middle-right;
}

.bar.fact-bar {
    height: 3px;
    margin: 3px 0 0 23px;
}

/* Действия планеты */

.actions-card {
    margin-bottom: 10px;
    padding: 8px 10px 10px 10px;
    background-color: rgba(240, 164, 58, 0.04);
    border-width: 1px;
    border-color: rgba(214, 162, 78, 0.35);
    border-radius: 3px;
}

.actions-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.actions-title {
    font-size: 17px;
    color: var(--orange);
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.actions-left {
    font-size: 12px;
    color: var(--muted);
}

.actions-section {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
    margin: 9px 0 4px 2px;
}

.action-item {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    margin: 0 0 4px 0;
    padding: 4px 10px;
    color: var(--text);
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.55);
    border-radius: 3px;
    transition-duration: 0.12s;
}

.action-item:hover {
    background-color: var(--button-hover);
    border-color: rgba(240, 164, 58, 0.7);
}

.action-item:active {
    background-color: var(--button-active);
}

.action-item:disabled {
    opacity: 0.4;
}

.action-item.accent {
    background-color: rgba(120, 74, 20, 0.55);
    border-color: var(--orange);
}

.action-item.accent > .ai-icon,
.action-item.accent .ai-title {
    color: #ffd08a;
}

.action-item.danger {
    background-color: rgba(70, 18, 16, 0.85);
    border-color: rgba(220, 70, 58, 0.85);
}

.action-item.danger .ai-title {
    color: var(--red);
}

.action-item.quiet {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 255, 0.08);
}

.action-item.quiet .ai-title {
    color: var(--text-dim);
}

.action-item.info {
    background-color: rgba(255, 255, 255, 0.025);
    border-color: rgba(255, 255, 255, 0.05);
}

.ai-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    color: var(--gold);
}

.ai-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.ai-title {
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    white-space: normal;
}

.ai-effect {
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
}

.ai-cost {
    flex-shrink: 0;
    margin-left: 10px;
    font-size: 12px;
    color: #ffc36b;
    -unity-text-align: middle-right;
}

.rule-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.rule-label {
    width: 70px;
    font-size: 13px;
    color: var(--text-dim);
}

.rule-choice {
    flex-grow: 1;
}

.rule-choice > .segment {
    font-size: 12px;
    min-height: 30px;
}

.actions-card .check-text {
    font-size: 13px;
}

/* Подробнее */

.fold {
    margin-bottom: 4px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.fold-head {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin: 0;
    padding: 0 4px;
    font-size: 14px;
    color: var(--text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.fold-head:hover {
    color: var(--orange);
}

.fold-arrow {
    width: 14px;
    height: 14px;
    margin-right: 8px;
    transition-duration: 0.12s;
}

.fold.open > .fold-head > .fold-arrow {
    rotate: 90deg;
}

.fold-body {
    display: none;
    padding: 2px 4px 8px 26px;
}

.fold.open > .fold-body {
    display: flex;
}

/* Текст панели */

.title {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-bottom: 6px;
    white-space: normal;
}

.header {
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--orange);
    margin-top: 6px;
    margin-bottom: 5px;
}

.text {
    white-space: normal;
    margin-bottom: 3px;
}

.small {
    font-size: 13px;
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: 3px;
}

.line {
    flex-direction: row;
    margin-bottom: 3px;
}

.line-name {
    width: 200px;
    flex-shrink: 0;
    color: var(--muted);
    white-space: normal;
}

.line-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
}

.row > .button {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.tax-label {
    width: 80px;
}

.tax-choice {
    flex-grow: 1;
}

.tax-choice > .segment {
    font-size: 13px;
    min-height: 30px;
}

.cell-res {
    width: 110px;
}

.cell-stock {
    width: 90px;
}

.cell-price {
    width: 110px;
}

.row > .market-button {
    font-size: 14px;
    min-height: 30px;
    margin-right: 0;
    margin-left: 4px;
}

.card {
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-line);
    border-radius: 3px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.card.alert {
    background-color: rgba(255, 93, 79, 0.08);
    border-color: rgba(255, 93, 79, 0.45);
}

.space-s {
    height: 6px;
}

.space-m {
    height: 10px;
}

.space-l {
    height: 14px;
}

.bar {
    height: 8px;
    margin-left: 200px;
    margin-top: 2px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
}

.bar.wide {
    margin-left: 0;
}

.bar-fill {
    height: 100%;
}

/* Кнопки */

.button {
    min-height: 34px;
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 15px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: var(--button-line);
    border-radius: 3px;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: var(--button-hover);
    border-color: rgba(240, 164, 58, 0.7);
}

.button:active {
    background-color: var(--button-active);
}

.button:disabled {
    opacity: 0.4;
}

.segmented {
    flex-direction: row;
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-radius: 0;
    border-left-width: 0;
}

.segment.first {
    border-left-width: 1px;
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.segment.last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

.button.selected {
    color: var(--orange);
    background-color: rgba(70, 45, 15, 0.7);
    border-color: var(--orange);
}

.check {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 4px;
    margin-bottom: 6px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: upper-left;
}

.check-box {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
    margin-top: 1px;
    border-width: 1px;
    border-color: var(--button-line);
    border-radius: 3px;
    background-color: var(--button-bg);
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgba(0, 0, 0, 0);
}

.check:hover > .check-box {
    border-color: var(--orange);
}

.check.on > .check-box {
    background-color: rgb(236, 157, 52);
    border-color: rgb(255, 196, 110);
    color: #2b1803;
}

.check-text {
    flex-shrink: 1;
    white-space: normal;
}

/* Окна поверх: ход соперников, журнал */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.rivals-card {
    min-width: 660px;
    max-width: 1460px;
    padding: 16px 24px;
    --frame-fill: rgba(9, 12, 19, 0.98);
}

.rivals-fill {
    background-color: var(--orange);
}

/* Лояльность жителей — под окном планеты */

.loyalty {
    margin: 6px 0 8px 0;
    padding: 8px 12px 8px 10px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-line);
    border-radius: 3px;
}

.loyalty.alert {
    background-color: rgba(70, 18, 16, 0.6);
    border-color: rgba(220, 70, 58, 0.85);
}

.loyalty-row {
    flex-direction: row;
    align-items: center;
}

.loyalty-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
}

.loyalty-title {
    font-size: 15px;
    color: var(--text);
}

.loyalty-value {
    font-size: 24px;
    margin-right: 10px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.loyalty-change {
    font-size: 13px;
}

.loyalty-bar {
    height: 9px;
    margin-top: 6px;
    background-color: rgba(255, 255, 255, 0.07);
    border-radius: 2px;
    overflow: hidden;
}

.loyalty-zone,
.loyalty-fill {
    position: absolute;
    top: 0;
    bottom: 0;
}

.loyalty-fill {
    left: 0;
    opacity: 0.85;
}

.loyalty-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(8, 10, 16, 0.85);
}

.loyalty-status {
    font-size: 12px;
    color: var(--text-dim);
    margin-top: 5px;
    white-space: normal;
}

/* Портреты магнатов: 3D-бюст в рамке цвета магната */

.magnate-frame {
    flex-shrink: 0;
    margin-right: 12px;
}

.magnate-image {
    flex-grow: 1;
}

/* Линии рамки и засечки — поверх портрета. */
.magnate-border {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.magnate-about {
    flex-grow: 1;
    flex-shrink: 1;
}

.rivals-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin: 8px 0 6px 0;
}

.rival-card {
    align-items: center;
    margin: 0 7px 10px 7px;
}

.rival-card .magnate-frame {
    margin-right: 0;
    transition-duration: 0.25s;
}

.rival-card.thinking .magnate-frame {
    scale: 1.07 1.07;
}

.rival-name {
    font-size: 14px;
    margin-top: 6px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.rival-state {
    font-size: 12px;
    color: var(--text-dim);
}

.rival-card.thinking .rival-state {
    color: #ffd08a;
}

.rival-said {
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: upper-center;
    margin-top: 2px;
}

/* Секторы над картой: вкладки и карточка лицензии */

.sector-tabs {
    flex-direction: row;
    margin: 4px 0 4px 0;
}

.sector-tab {
    flex-direction: row;
    align-items: center;
    height: 24px;
    margin: 0 6px 0 0;
    padding: 0 10px;
    font-size: 12px;
    color: var(--text-dim);
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: var(--button-line);
    border-radius: 3px;
}

.sector-tab:hover {
    background-color: var(--button-hover);
}

.sector-tab.selected {
    border-color: var(--orange);
    color: #ffd08a;
    background-color: rgba(120, 74, 20, 0.55);
}

.sector-tab .icon {
    width: 12px;
    height: 12px;
    margin-right: 5px;
}

.sector-lock {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 440px;
    padding: 18px 22px;
    --frame-fill: rgba(9, 12, 19, 0.96);
}

.sector-lock-text {
    font-size: 14px;
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: 6px;
}

.sector-buy {
    white-space: normal;
}

.sector-buy:disabled {
    opacity: 0.55;
}

/* Экран выбора стартового персонажа */

.start-overlay {
    background-color: rgba(0, 0, 0, 0.62);
}

.start-card {
    width: 1180px;
    padding: 20px 26px 18px 26px;
    --frame-fill: rgba(9, 12, 19, 0.98);
}

.start-subtitle {
    font-size: 15px;
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: 14px;
}

.start-characters {
    flex-direction: row;
}

.character-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
    padding: 14px 16px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-line);
    border-radius: 3px;
}

.character-card:hover {
    background-color: rgba(214, 162, 78, 0.07);
    border-color: var(--orange);
}

.character-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.character-icon {
    width: 40px;
    height: 40px;
    margin-right: 12px;
    color: var(--gold);
}

.character-name {
    font-size: 22px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.skill-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
}

.skill-name {
    width: 140px;
    font-size: 13px;
    color: var(--text-dim);
}

.pip {
    width: 14px;
    height: 7px;
    margin-right: 3px;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.1);
}

.pip.on {
    background-color: var(--gold);
}

.character-start {
    font-size: 13px;
    color: var(--muted);
    margin: 8px 0 8px 0;
}

.character-plus,
.character-minus {
    font-size: 13px;
    white-space: normal;
    margin-bottom: 6px;
}

.character-plus {
    color: var(--green);
}

.character-minus {
    color: #ff8a7a;
    flex-grow: 1;
}

.character-pick {
    height: 40px;
    margin: 8px 0 0 0;
    background-color: rgba(120, 74, 20, 0.95);
    border-width: 1px;
    border-color: var(--orange);
    border-radius: 3px;
    color: #ffd08a;
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.character-pick:hover {
    background-color: rgba(150, 94, 28, 1);
    color: #ffe2b0;
}

.start-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 0 6px;
}

.start-note {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-right: 16px;
}

.start-cancel {
    flex-shrink: 0;
    padding: 0 16px;
    margin-left: 8px;
}

/* «Продолжить партию» — главная кнопка экрана выбора, если есть автосохранение. */
.start-continue {
    background-color: rgba(120, 74, 20, 0.95);
    border-color: var(--orange);
    color: #ffd08a;
}

.start-continue:hover {
    background-color: rgba(150, 94, 28, 1);
    color: #ffe2b0;
}

/* Окно сохранений: строка — партия, ход, капитал, когда сохранена; «Загрузить» и удалить. */
.saves-card {
    width: 720px;
    height: 520px;
}

.save-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.save-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

.save-text {
    flex-shrink: 1;
}

.save-title {
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-bottom: 2px;
}

.save-row .button {
    padding: 0 14px;
    margin-right: 6px;
}

.journal-card {
    width: 900px;
    height: 640px;
    padding: 16px 20px;
    --frame-fill: rgba(9, 12, 19, 0.98);
}

.journal-list {
    flex-grow: 1;
}

.journal-list .event-row {
    height: auto;
    min-height: 26px;
    padding: 3px 0;
}

.journal-list .event-text {
    white-space: normal;
}

/* Подсказка */

.tooltip {
    position: absolute;
    padding: 5px 8px;
    font-size: 13px;
    color: var(--text-dim);
    background-color: rgba(8, 10, 16, 0.96);
    border-width: 1px;
    border-color: rgba(92, 78, 52, 0.9);
    border-radius: 3px;
}

/* Окно «Важное за ход»: карточки событий, у каждого вида свой цвет полосы и значка. */
.alerts-card {
    width: 780px;
    max-height: 780px;
    padding: 16px 20px;
    --frame-fill: rgba(9, 12, 19, 0.98);
}

.alerts-title {
    color: var(--orange);
    margin-bottom: 10px;
}

.alerts-list {
    flex-shrink: 1;
    max-height: 620px;
}

.alert-card {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 12px;
    margin-bottom: 8px;
    background-color: var(--card-bg);
    border-left-width: 3px;
    border-radius: 3px;
}

.alert-badge {
    width: 70px;
    height: 70px;
    margin-right: 12px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.04);
}

.alert-badge-icon {
    width: 34px;
    height: 34px;
}

.alert-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.alert-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.alert-kind-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.alert-title {
    font-size: 16px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.alert-who {
    font-size: 13px;
    color: var(--muted);
    margin-left: 8px;
}

.alert-text {
    font-size: 13px;
    color: var(--text-dim);
    white-space: normal;
}

.alert-go {
    align-self: flex-start;
    margin-top: 8px;
}

.alert-lost { border-left-color: var(--red); }
.alert-lost .alert-title, .alert-lost .alert-kind-icon, .alert-lost .alert-badge-icon { color: #ff8a7a; }
.alert-threat { border-left-color: var(--orange); }
.alert-threat .alert-title, .alert-threat .alert-kind-icon, .alert-threat .alert-badge-icon { color: #ffc067; }
.alert-disaster { border-left-color: #ff7a45; }
.alert-disaster .alert-title, .alert-disaster .alert-kind-icon, .alert-disaster .alert-badge-icon { color: #ff9a6b; }
.alert-trick { border-left-color: #a77bff; }
.alert-trick .alert-title, .alert-trick .alert-kind-icon, .alert-trick .alert-badge-icon { color: #c6a8ff; }
.alert-good { border-left-color: var(--green); }
.alert-good .alert-title, .alert-good .alert-kind-icon, .alert-good .alert-badge-icon { color: #7fe3a8; }

.alerts-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.alerts-note {
    flex-grow: 1;
}

.alerts-ok {
    width: 170px;
    height: 38px;
    margin: 0;
    background-color: rgba(120, 74, 20, 0.95);
    border-width: 1px;
    border-color: var(--orange);
    border-radius: 3px;
    color: #ffd08a;
    font-size: 16px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.alerts-ok:hover {
    background-color: rgba(150, 94, 28, 1);
    color: #ffe2b0;
}

/* Шоу «Риелтор года»: верхняя плашка, окно с заданиями и рейтингом, случаи, лот. */
.stat.show > .stat-icon,
.stat.show .stat-value {
    color: #f0c45a;
}

.pill.lot {
    color: #f0c45a;
    border-color: rgba(240, 196, 90, 0.75);
    background-color: rgba(120, 90, 20, 0.35);
}

.incident-chip {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 0 10px 0 0;
    padding: 0 14px;
    background-color: rgba(40, 30, 70, 0.95);
    border-width: 1px;
    border-color: #a77bff;
    border-radius: 3px;
    color: #d9c6ff;
}

.incident-chip:hover {
    background-color: rgba(60, 44, 100, 1);
}

.incident-chip > .icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
}

.incident-chip-text {
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-card {
    width: 760px;
}

.show-host {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgba(240, 196, 90, 0.07);
    border-left-width: 3px;
    border-color: #f0c45a;
    border-radius: 3px;
}

.show-host-icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    color: #f0c45a;
}

.show-host-text {
    flex-shrink: 1;
    white-space: normal;
    font-size: 14px;
    color: var(--text);
}

.show-section {
    font-size: 13px;
    color: var(--muted);
    margin: 10px 0 4px 0;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-task {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 5px;
    background-color: var(--card-bg);
    border-radius: 3px;
}

.show-task-icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
    color: var(--muted);
}

.show-task.done .show-task-icon,
.show-task.done .show-task-title,
.show-task.done .show-task-amount {
    color: var(--green);
}

.show-task-text {
    flex-shrink: 1;
    width: 420px;
}

.show-task-title {
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-task-bar {
    height: 4px;
    margin-top: 5px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.08);
}

.show-task-fill {
    height: 4px;
    border-radius: 2px;
    background-color: #f0c45a;
}

.show-task.done .show-task-fill {
    background-color: var(--green);
}

.show-task-amount {
    font-size: 13px;
    color: var(--text-dim);
    margin-right: 14px;
}

.show-task-points {
    font-size: 15px;
    color: #f0c45a;
    width: 40px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-rank {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.show-rank.mine {
    background-color: rgba(88, 214, 141, 0.07);
}

.show-rank-place {
    width: 22px;
    font-size: 15px;
    color: var(--muted);
}

.show-rank-crown {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    color: #f0c45a;
}

.show-rank-name {
    font-size: 15px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-rank-done {
    font-size: 12px;
    color: var(--muted);
    margin-right: 16px;
}

.show-rank-points {
    font-size: 17px;
    width: 46px;
    -unity-text-align: middle-right;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.show-note {
    margin-top: 10px;
    white-space: normal;
}

.incident-card {
    width: 700px;
}

.incident-head {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 12px;
}

.incident-icon {
    color: #c6a8ff;
}

.incident-kicker {
    font-size: 12px;
    color: #c6a8ff;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.incident-title {
    margin-bottom: 4px;
}

.incident-text {
    font-size: 15px;
    color: var(--text);
}

.incident-choices {
    margin-bottom: 4px;
}

.incident-choice {
    flex-direction: row;
    align-items: center;
    height: 42px;
    margin: 0 0 6px 0;
    padding: 0 14px;
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: var(--button-line);
    border-radius: 3px;
}

.incident-choice:hover {
    background-color: var(--button-hover);
    border-color: rgba(240, 164, 58, 0.7);
}

.incident-choice:disabled {
    opacity: 0.45;
}

.incident-choice-label {
    font-size: 15px;
    color: var(--text);
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.incident-choice-cost {
    font-size: 13px;
    color: #f0c45a;
}

.incident-result {
    padding: 6px 2px 12px 2px;
}

.alert-show { border-left-color: #f0c45a; }
.alert-show .alert-title, .alert-show .alert-kind-icon, .alert-show .alert-badge-icon { color: #f0c45a; }

.show-note,
.alerts-note {
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
    flex-shrink: 1;
    margin-right: 10px;
}

/* Итоги сезона: ведущий с репликой, кубок, пьедестал, приз. */
.season-overlay {
    background-color: rgba(0, 0, 0, 0.72);
}

.season-card {
    width: 820px;
    padding: 20px 28px;
    --frame-fill: rgba(10, 11, 20, 0.98);
    --frame-line: rgba(240, 196, 90, 0.8);
}

.season-title {
    font-size: 30px;
    color: #f0c45a;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-bottom: 14px;
}

.season-stage {
    flex-direction: row;
    align-items: center;
}

.season-host {
    flex-direction: row;
    align-items: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
}

.season-bubble {
    flex-shrink: 1;
    margin-top: 18px;
    padding: 10px 14px;
    max-width: 300px;
    background-color: rgba(240, 196, 90, 0.1);
    border-width: 1px;
    border-color: rgba(240, 196, 90, 0.45);
    border-radius: 10px;
}

.season-bubble-name {
    font-size: 12px;
    color: #f0c45a;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.season-bubble-text {
    font-size: 15px;
    color: var(--text);
    white-space: normal;
}

.season-cup-box {
    width: 230px;
    align-items: center;
}

.season-cup {
    width: 150px;
    height: 150px;
}

.season-place {
    font-size: 26px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.season-points {
    font-size: 14px;
    color: var(--muted);
}

.season-podium {
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    margin-top: 16px;
}

.podium-column {
    width: 170px;
    align-items: stretch;
    margin: 0 4px;
}

.podium-name {
    font-size: 15px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.podium-points {
    font-size: 13px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.podium-block {
    background-color: rgba(255, 255, 255, 0.06);
    border-top-width: 3px;
    border-radius: 2px;
    justify-content: center;
    align-items: center;
}

.podium-number {
    font-size: 26px;
    color: rgba(255, 255, 255, 0.55);
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
}

.season-prize {
    margin-top: 14px;
    font-size: 15px;
    color: var(--text);
    -unity-text-align: middle-center;
    white-space: normal;
}
