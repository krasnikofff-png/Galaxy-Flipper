:root {
    --panel-bg: rgba(14, 18, 30, 0.92);
    --panel-border: rgba(120, 150, 210, 0.22);
    --card-bg: rgba(255, 255, 255, 0.045);
    --text: #e6e9f0;
    --text-dim: #bfc7d9;
    --text-muted: #8a93a6;
    --header: #99bfff;
    --accent: #4d8fe0;
    --button-bg: rgba(64, 86, 130, 0.55);
    --button-hover: rgba(86, 114, 170, 0.75);
    --button-active: rgba(46, 64, 100, 0.9);
    --button-border: rgba(140, 170, 230, 0.35);
}

/* Каркас экрана */

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-Regular.ttf");
    font-size: 16px;
    color: var(--text);
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
}

.spacer {
    flex-grow: 1;
}

/* Верхняя панель */

.top-bar {
    height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: var(--panel-bg);
    border-bottom-width: 1px;
    border-color: var(--panel-border);
}

.stats {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.stat {
    margin-right: 22px;
}

.button.top-button {
    height: 34px;
    margin: 0 0 0 8px;
    padding-left: 14px;
    padding-right: 14px;
}

.button.end-turn {
    width: 150px;
    background-color: rgba(60, 120, 90, 0.7);
    border-color: rgba(120, 220, 160, 0.45);
}

.button.end-turn:hover {
    background-color: rgba(76, 150, 112, 0.85);
}

.event-bar {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: var(--text-dim);
    background-color: rgba(255, 255, 255, 0.06);
}

.event-bar.active {
    color: var(--text);
    background-color: rgba(242, 191, 77, 0.22);
}

/* Тело: карта и правая панель */

.body {
    flex-grow: 1;
    flex-direction: row;
    margin: 10px;
}

.map {
    flex-grow: 1;
    overflow: hidden;
}

.map-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.map-label {
    position: absolute;
    width: 140px;
    font-size: 12px;
    -unity-text-align: upper-center;
    color: var(--text-dim);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

.map-hint {
    position: absolute;
    right: 12px;
    top: 8px;
    font-size: 11px;
    color: rgba(191, 204, 230, 0.55);
}

.probe-bar {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 8px;
    height: 34px;
    flex-direction: row;
}

.probe-types {
    width: 420px;
}

.probe-bar .segment {
    font-size: 14px;
    padding-left: 4px;
    padding-right: 4px;
    white-space: nowrap;
}

.probe-missions {
    width: 300px;
    margin-left: 12px;
}

.probe-done {
    width: 90px;
}

.legend {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 6px;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 3px 6px;
    border-radius: 5px;
    background-color: rgba(6, 8, 16, 0.72);
}

.legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
    font-size: 12px;
    color: var(--text-dim);
}

.legend-gap {
    width: 20px;
}

.dot {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 5px;
}

.side {
    width: 560px;
    margin-left: 10px;
    padding: 10px 12px;
}

.tabs {
    height: 34px;
    flex-shrink: 0;
}

.tabs > .segment {
    font-size: 14px;
    padding-left: 2px;
    padding-right: 2px;
}

.side-scroll {
    flex-grow: 1;
    margin-top: 10px;
}

.log {
    height: 190px;
    margin: 0 10px 10px 10px;
    padding: 8px 4px 8px 12px;
}

.log-line {
    font-size: 14px;
    white-space: normal;
    margin-bottom: 2px;
}

/* Текст панели */

.title {
    font-size: 24px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    margin-bottom: 6px;
    white-space: normal;
}

.header {
    font-size: 17px;
    -unity-font-definition: url("project://database/Assets/Resources/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--header);
    margin-top: 4px;
    margin-bottom: 4px;
}

.text {
    white-space: normal;
    margin-bottom: 3px;
}

.small {
    font-size: 13px;
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: 3px;
}

.line {
    flex-direction: row;
    margin-bottom: 3px;
}

.line-name {
    width: 200px;
    flex-shrink: 0;
    color: var(--text-dim);
    white-space: normal;
}

.line-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.row {
    flex-direction: row;
    align-items: center;
}

.row > .button {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.tax-label {
    width: 80px;
}

.tax-choice {
    flex-grow: 1;
}

.tax-choice > .segment {
    font-size: 13px;
    min-height: 30px;
}

.cell-res {
    width: 110px;
}

.cell-stock {
    width: 90px;
}

.cell-price {
    width: 110px;
}

.row > .market-button {
    font-size: 14px;
    min-height: 30px;
    margin-right: 0;
    margin-left: 4px;
}

.card {
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 6px;
}

.card.alert {
    background-color: rgba(255, 110, 90, 0.08);
    border-color: rgba(255, 138, 122, 0.4);
}

.space-s {
    height: 6px;
}

.space-m {
    height: 10px;
}

.space-l {
    height: 14px;
}

.bar {
    height: 10px;
    margin-left: 200px;
    margin-top: 2px;
    margin-bottom: 6px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
    overflow: hidden;
}

.bar.wide {
    margin-left: 0;
}

.bar-fill {
    height: 100%;
}

/* Кнопки */

.button {
    min-height: 34px;
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 4px 10px;
    font-size: 15px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: var(--button-bg);
    border-width: 1px;
    border-color: var(--button-border);
    border-radius: 5px;
    transition-duration: 0.12s;
}

.button:hover {
    background-color: var(--button-hover);
}

.button:active {
    background-color: var(--button-active);
}

.button:disabled {
    opacity: 0.4;
}

.segmented {
    flex-direction: row;
}

.segment {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    border-radius: 0;
    border-left-width: 0;
}

.segment.first {
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.segment.last {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

.button.selected {
    background-color: var(--accent);
    border-color: rgba(170, 205, 255, 0.7);
}

.check {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 4px;
    margin-bottom: 6px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: upper-left;
}

.check-box {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 8px;
    margin-top: 1px;
    border-width: 1px;
    border-color: var(--button-border);
    border-radius: 4px;
    background-color: var(--button-bg);
    font-size: 13px;
    -unity-text-align: middle-center;
    color: rgba(0, 0, 0, 0);
}

.check:hover > .check-box {
    background-color: var(--button-hover);
}

.check.on > .check-box {
    background-color: var(--accent);
    color: #ffffff;
}

.check-text {
    flex-shrink: 1;
    white-space: normal;
}

/* Окно планеты */

.portrait {
    height: 210px;
    margin-top: 2px;
    margin-bottom: 8px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #05060c;
}

.portrait-button {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 124px;
    min-height: 26px;
    font-size: 13px;
    padding: 2px 6px;
}

.portrait-hint {
    position: absolute;
    left: 10px;
    bottom: 5px;
    font-size: 11px;
    color: rgba(191, 204, 230, 0.6);
}

/* Ход соперников */

.rivals {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.rivals-card {
    width: 660px;
    height: 300px;
    padding: 14px 20px;
    background-color: rgba(14, 18, 30, 0.97);
}

.rivals-fill {
    background-color: rgb(153, 204, 255);
}

/* Подсказка */

.tooltip {
    position: absolute;
    padding: 5px 8px;
    font-size: 13px;
    color: var(--text-dim);
    background-color: rgba(10, 12, 20, 0.95);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 4px;
}
