// Запекание текстур планеты на видеокарте: тот же шум и те же правила поверхности, что в PlanetNoise.cs и
// PlanetSurface.cs (один в один, чтобы облик всех восьми типов не изменился), но для всех пикселей сразу.
// Ядро Surface считает цвет, высоту, блеск, свечение и облака; ядро Normals — рельеф по соседним высотам
// (как в PlanetBaker при ширине от 256). Таблицы перестановок шума (рельеф и облака) приходят буферами.
#pragma kernel Surface
#pragma kernel Normals

StructuredBuffer<int> _Perm;        // 512 чисел, шум рельефа (зерно планеты)
StructuredBuffer<int> _CloudPerm;   // 512 чисел, шум облаков (зерно + 1)
RWStructuredBuffer<float> _Heights; // высота по пикселям, Surface → Normals
RWTexture2D<float4> _Albedo;        // цвет, A — блеск
RWTexture2D<float4> _Emission;
RWTexture2D<float4> _Clouds;        // белое, A — плотность облаков
RWTexture2D<float4> _Normal;        // нормали в пространстве планеты, 0…1

int _Width, _Height;
int _Look;          // PlanetLook: 0 Jungle, 1 Ice, 2 Rocky, 3 Gas, 4 Crystal, 5 Anomaly, 6 Volcanic, 7 Ocean
float _CloudAmount; // PlanetStyle.Clouds
int _Smooth;        // 1 — рельеф не наклоняет нормаль (газовый гигант)

static const float PI = 3.14159265358979f;

static const float3 GRAD[12] =
{
    float3(1, 1, 0), float3(-1, 1, 0), float3(1, -1, 0), float3(-1, -1, 0),
    float3(1, 0, 1), float3(-1, 0, 1), float3(1, 0, -1), float3(-1, 0, -1),
    float3(0, 1, 1), float3(0, -1, 1), float3(0, 1, -1), float3(0, -1, -1),
};

// ----------------------------------------------------------------------
// Шум (PlanetNoise.cs): which — 0 рельеф, 1 облака
// ----------------------------------------------------------------------

int P(int which, int i) { return which == 0 ? _Perm[i] : _CloudPerm[i]; }

float Fade(float t) { return t * t * t * (t * (t * 6 - 15) + 10); }

float G(int which, int ix, int iy, int iz, float dx, float dy, float dz)
{
    float3 g = GRAD[(uint)P(which, P(which, P(which, ix) + iy) + iz) % 12u];
    return g.x * dx + g.y * dy + g.z * dz;
}

float Perlin(int which, float3 q)
{
    int x0 = (int)floor(q.x), y0 = (int)floor(q.y), z0 = (int)floor(q.z);
    float fx = q.x - x0, fy = q.y - y0, fz = q.z - z0;
    int x = x0 & 255, y = y0 & 255, z = z0 & 255;
    int x1 = (x + 1) & 255, y1 = (y + 1) & 255, z1 = (z + 1) & 255;
    float ux = Fade(fx), uy = Fade(fy), uz = Fade(fz);
    float a = G(which, x, y, z, fx, fy, fz), b = G(which, x1, y, z, fx - 1, fy, fz);
    float c = G(which, x, y1, z, fx, fy - 1, fz), d = G(which, x1, y1, z, fx - 1, fy - 1, fz);
    float e = G(which, x, y, z1, fx, fy, fz - 1), f = G(which, x1, y, z1, fx - 1, fy, fz - 1);
    float g = G(which, x, y1, z1, fx, fy - 1, fz - 1), h = G(which, x1, y1, z1, fx - 1, fy - 1, fz - 1);
    float l0 = a + ux * (b - a), l1 = c + ux * (d - c), l2 = e + ux * (f - e), l3 = g + ux * (h - g);
    float m0 = l0 + uy * (l1 - l0), m1 = l2 + uy * (l3 - l2);
    return m0 + uz * (m1 - m0);
}

float Fbm(int which, float3 q, int octaves, float offset)
{
    float s = 0, a = 1, f = 1, n = 0;
    for (int o = 0; o < octaves; o++)
    {
        s += a * Perlin(which, q * f + (offset + o * 17.13f));
        n += a;
        a *= 0.5f;
        f *= 2;
    }
    return s / n;
}

float Fbm(int which, float3 q, int octaves) { return Fbm(which, q, octaves, 0); }

float Ridged(int which, float3 q, int octaves, float offset)
{
    float s = 0, a = 1, f = 1, n = 0;
    for (int o = 0; o < octaves; o++)
    {
        float r = 1 - abs(Perlin(which, q * f + (offset + o * 9.1f)));
        s += a * r * r;
        n += a;
        a *= 0.5f;
        f *= 2.1f;
    }
    return s / n;
}

float Ridged(int which, float3 q) { return Ridged(which, q, 5, 31.7f); }

void Cells(int which, float3 q, float scale, float offset, out float d1, out float d2, out int id)
{
    float3 qq = q * scale + offset;
    int bx = (int)floor(qq.x), by = (int)floor(qq.y), bz = (int)floor(qq.z);
    d1 = 9; d2 = 9; id = 0;
    for (int dx = -1; dx <= 1; dx++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dz = -1; dz <= 1; dz++)
    {
        int cx = bx + dx, cy = by + dy, cz = bz + dz;
        int h = P(which, (P(which, (P(which, cx & 255) + cy) & 511) + cz) & 511);
        float3 jit = float3(P(which, (h + 1) & 511), P(which, (h + 2) & 511), P(which, (h + 3) & 511)) / 255.0f;
        float d = length(float3(cx, cy, cz) + jit - qq);
        if (d < d1)
        {
            d2 = d1;
            d1 = d;
            id = h;
        }
        else if (d < d2) d2 = d;
    }
}

// ----------------------------------------------------------------------
// Поверхность (PlanetSurface.cs)
// ----------------------------------------------------------------------

struct Sample
{
    float3 Color;
    float Height;
    float Spec;
    float3 Glow;
};

float3 V(float r, float g, float b) { return float3(r, g, b) / 255.0f; }
float3 Mix(float3 a, float3 b, float t) { return a + (b - a) * t; }

float3 Warp(float3 q, float freq, float amount)
{
    return q + amount * float3(Fbm(0, q * freq, 4, 5.1f), Fbm(0, q * freq, 4, 11.7f), Fbm(0, q * freq, 4, 23.3f));
}

Sample Empty()
{
    Sample s;
    s.Color = 0; s.Height = 0; s.Spec = 0; s.Glow = 0;
    return s;
}

Sample Jungle(float3 q)
{
    float3 qw = Warp(q, 1.4f, 0.38f);
    float elev = Fbm(0, qw * 1.15f, 7) * 1.3f + 0.03f;
    float lat = abs(q.y);
    float moist = Fbm(0, q * 2.0f, 5, 101) * 0.9f + 0.25f;
    float mount = saturate((Ridged(0, qw * 3.0f) - 0.70f) * 5) * saturate(elev * 5);
    Sample s = Empty();
    if (elev <= 0)
    {
        float depth = saturate(-elev * 5);
        s.Color = Mix(Mix(V(48, 190, 190), V(20, 120, 160), saturate(depth / 0.25f)), V(12, 58, 110), saturate((depth - 0.25f) / 0.75f));
        s.Color += V(120, 255, 240) * (saturate(1 - depth * 4) * 0.10f);
        s.Height = -0.01f;
        s.Spec = 1;
        return s;
    }
    float grove = Fbm(0, q * 10, 3, 77);
    float tree = Perlin(0, q * 110 + 3.3f) * 0.6f + Perlin(0, q * 230 + 7.7f) * 0.4f;
    float dry = saturate((0.1f - moist) * 3);
    float3 b = Mix(V(80, 140, 45), V(170, 120, 70), dry);
    b = Mix(b, V(190, 95, 60), saturate((-0.2f - moist) * 4));
    float beach = saturate(1 - elev * 30);
    float forest = saturate((grove * 1.4f + moist * 0.9f) * 2.5f) * (1 - beach) * (1 - mount);
    float treeness = saturate((tree + 0.1f) * 3.2f) * forest;
    float3 leaf = Mix(V(28, 92, 30), V(55, 130, 40), saturate(tree * 1.5f + 0.5f));
    b = Mix(b, leaf, treeness);
    b = Mix(b, V(225, 205, 150), beach * 0.9f);
    b = Mix(b, V(120, 110, 90), mount * 0.85f);
    b = Mix(b, V(240, 245, 248), saturate((mount - 0.6f) * 3) * saturate(elev * 3));
    b = Mix(b, V(235, 240, 245), saturate((lat - 0.86f) * 8));
    s.Color = b;
    s.Height = elev * 0.12f + mount * 0.22f + treeness * 0.012f;
    return s;
}

Sample Ice(float3 q)
{
    float3 w = float3(Fbm(0, q * 1.6f, 4, 5.1f), Fbm(0, q * 1.6f, 4, 11.7f), Fbm(0, q * 1.6f, 4, 23.3f));
    float3 qw = q + 0.3f * w;
    float elev = Fbm(0, qw * 1.3f, 7) * 1.2f - 0.05f;
    Sample s = Empty();
    if (elev > 0)
    {
        float crack = saturate((Ridged(0, qw * 6, 4, 13) - 0.82f) * 7);
        float drift = Fbm(0, q * 14, 4, 44);
        float3 b = Mix(V(225, 238, 248), V(190, 215, 240), saturate(drift * 1.5f + 0.3f));
        b = Mix(b, V(120, 170, 215), crack * 0.7f);
        float ridges = saturate((Ridged(0, qw * 2.5f, 5, 61) - 0.72f) * 5) * saturate(elev * 4);
        b = Mix(b, V(160, 190, 215), ridges * 0.5f);
        s.Color = b;
        s.Height = elev * 0.10f + ridges * 0.16f - crack * 0.02f;
        s.Spec = 0.35f;
        return s;
    }
    float d1, d2; int id;
    Cells(0, qw + 0.08f * w, 4.5f, 3.3f, d1, d2, id);
    float floeEdge = saturate(1 - (d2 - d1) * 14) * saturate((Fbm(0, q * 3, 3, 71) + 0.1f) * 3);
    float3 sea = Mix(V(150, 190, 220), V(95, 145, 190), saturate(-elev * 4));
    sea = Mix(sea, V(150, 195, 225), floeEdge * 0.45f);
    sea = Mix(sea, V(215, 232, 246), saturate((Fbm(0, q * 5, 4, 88) + 0.1f) * 2.5f) * 0.75f);
    s.Color = sea;
    s.Height = -0.005f + floeEdge * 0.01f;
    s.Spec = 0.8f;
    return s;
}

Sample Rocky(float3 q)
{
    float3 qw = Warp(q, 1.5f, 0.45f);
    float elev = Fbm(0, qw * 1.3f, 7);
    float canyon = saturate((Ridged(0, qw * 2.2f, 5, 71) - 0.8f) * 6);
    float mesa = round(saturate(elev * 1.6f + 0.5f) * 6) / 6;
    float strata = sin(elev * 60 + Fbm(0, q * 8, 2, 9) * 3) * 0.5f + 0.5f;
    float3 b = Mix(V(150, 95, 60), V(190, 140, 95), mesa);
    b = Mix(b, V(110, 70, 50), strata * 0.25f);
    b = Mix(b, V(80, 55, 45), canyon * 0.85f);
    float cd, cd2; int cid;
    Cells(0, q, 5, 8.8f, cd, cd2, cid);
    bool crater = (uint)cid % 3u == 0;
    float rim = crater ? saturate(1 - abs(cd - 0.32f) * 14) : 0;
    float bowl = crater ? saturate(1 - cd / 0.3f) : 0;
    b = Mix(b, V(120, 80, 60), bowl * 0.5f);
    b = Mix(b, V(215, 170, 120), rim * 0.6f);
    float vein = saturate((Ridged(0, q * 9, 3, 91) - 0.9f) * 12);
    b = Mix(b, V(205, 210, 215), vein * 0.8f);
    Sample s = Empty();
    s.Color = b;
    s.Height = mesa * 0.10f - canyon * 0.08f - bowl * 0.05f + rim * 0.04f;
    s.Spec = vein * 0.9f;
    return s;
}

Sample Gas(float3 q)
{
    float turb = Fbm(0, q * float3(1.5f, 6, 1.5f), 6, 5);
    float swirl = Fbm(0, q * float3(3, 12, 3) + turb * 0.8f, 5, 19);
    float bnd = q.y * 7 + turb * 1.8f + swirl * 0.8f;
    float band = sin(bnd) * 0.5f + 0.5f;
    float band2 = sin(bnd * 2.3f + 1.1f) * 0.5f + 0.5f;
    float3 b = Mix(V(235, 215, 175), V(205, 140, 85), band);
    b = Mix(b, V(150, 90, 60), saturate(band2 - 0.6f) * 1.6f);
    b = Mix(b, V(250, 240, 220), saturate(swirl * 2) * 0.3f);
    float3 spotCenter = normalize(float3(0.55f, -0.3f, 0.78f));
    float d = length((q - spotCenter) * float3(1, 1.9f, 1));
    float spot = saturate(1 - d / 0.2f);
    float ring = sin(d * 60 + Fbm(0, q * 10, 2, 3) * 4) * 0.5f + 0.5f;
    b = Mix(b, Mix(V(200, 95, 60), V(240, 170, 120), ring), pow(spot, 0.6f));
    Sample s = Empty();
    s.Color = b;
    s.Height = band * 0.01f;
    return s;
}

Sample Crystal(float3 q)
{
    float3 qw = Warp(q, 1.4f, 0.3f);
    float elev = Fbm(0, qw * 1.3f, 6);
    float d1, d2; int cid;
    Cells(0, qw, 14, 4.4f, d1, d2, cid);
    float facet = ((uint)cid % 7u) / 7.0f;
    float field = saturate((Fbm(0, q * 2.5f, 4, 66) + 0.05f) * 4);
    float edge = saturate(1 - (d2 - d1) * 10);
    float3 ground = Mix(V(70, 60, 95), V(110, 95, 130), saturate(elev + 0.5f));
    float3 crys = Mix(V(120, 90, 220), V(150, 230, 255), facet);
    crys = Mix(crys, V(235, 215, 255), edge * 0.7f);
    Sample s;
    s.Color = Mix(ground, crys, field);
    s.Height = elev * 0.08f + field * (0.06f - d1 * 0.08f);
    s.Spec = field * 0.9f;
    s.Glow = V(170, 130, 255) * (field * edge * 0.25f);
    return s;
}

Sample Anomaly(float3 q)
{
    float3 qw = Warp(q, 2, 0.6f);
    float elev = Fbm(0, qw * 1.5f, 6);
    float fiss = saturate((Ridged(0, qw * 3.0f, 5, 13) - 0.74f) * 6);
    float3 b = Mix(V(45, 35, 70), V(95, 75, 125), saturate(elev + 0.5f));
    b = Mix(b, V(30, 22, 50), saturate(Fbm(0, q * 6, 3, 8) * 2) * 0.6f);
    float hue = saturate(Fbm(0, q * 1.2f, 3, 2) * 2 + 0.5f);
    float3 glowColor = Mix(V(60, 240, 230), V(255, 80, 220), hue);
    Sample s;
    s.Color = b;
    s.Height = elev * 0.1f - fiss * 0.05f;
    s.Spec = 0.2f;
    s.Glow = glowColor * (pow(fiss, 1.2f) * 1.6f);
    return s;
}

Sample Volcanic(float3 q)
{
    float3 qw = Warp(q, 1.6f, 0.5f);
    float elev = Fbm(0, qw * 1.3f, 7);
    float river = saturate((Ridged(0, qw * 2.6f, 5, 41) - 0.8f) * 6);
    float lake = saturate((-elev - 0.22f) * 6);
    float crust = saturate(Fbm(0, q * 9, 3, 57) * 2 + 0.5f);
    float3 rock = Mix(V(36, 30, 28), V(84, 70, 60), saturate(elev + 0.5f));
    rock = Mix(rock, V(24, 20, 20), crust * 0.4f);
    float cd, cd2; int cid;
    Cells(0, q, 6, 5.5f, cd, cd2, cid);
    bool volcano = (uint)cid % 4u == 0;
    float cone = volcano ? saturate(1 - cd / 0.35f) : 0;
    float vent = volcano ? saturate(1 - cd / 0.07f) : 0;
    rock = Mix(rock, V(100, 84, 72), cone * 0.45f);
    float hot = max(river, max(lake, vent));
    float3 lava = Mix(V(255, 80, 15), V(255, 205, 90), saturate(Fbm(0, q * 12, 3, 23) + 0.5f));
    Sample s;
    s.Color = Mix(rock, lava * 0.85f, hot * 0.85f);
    s.Height = elev * 0.10f + cone * 0.16f - vent * 0.1f - river * 0.03f - lake * 0.02f;
    s.Spec = hot * 0.3f;
    s.Glow = lava * (hot * 1.3f);
    return s;
}

Sample Ocean(float3 q)
{
    float3 qw = Warp(q, 1.3f, 0.35f);
    float elev = Fbm(0, qw * 1.6f, 7) * 1.25f - 0.36f;
    float lat = abs(q.y);
    Sample s = Empty();
    if (elev <= 0)
    {
        float depth = saturate(-elev * 3);
        float3 sea = Mix(V(45, 205, 205), V(20, 115, 180), saturate(depth / 0.12f));
        sea = Mix(sea, V(10, 42, 110), saturate((depth - 0.12f) / 0.88f));
        float current = Fbm(0, q * float3(2, 7, 2), 4, 140);
        sea = Mix(sea, sea * 1.25f, saturate(current * 2.5f) * 0.35f);
        sea = Mix(sea, V(225, 238, 248), saturate((lat - 0.88f) * 10));
        s.Color = sea;
        s.Height = -0.01f;
        s.Spec = 1;
        return s;
    }
    float beach = saturate(1 - elev * 22);
    float3 land = Mix(V(55, 135, 65), V(115, 155, 80), saturate(Fbm(0, q * 9, 3, 33) + 0.5f));
    land = Mix(land, V(232, 218, 170), beach);
    land = Mix(land, V(235, 240, 245), saturate((lat - 0.8f) * 8));
    s.Color = land;
    s.Height = elev * 0.15f;
    s.Spec = 0.1f;
    return s;
}

Sample Evaluate(float3 q)
{
    switch (_Look)
    {
        case 0: return Jungle(q);
        case 1: return Ice(q);
        case 2: return Rocky(q);
        case 3: return Gas(q);
        case 4: return Crystal(q);
        case 6: return Volcanic(q);
        case 7: return Ocean(q);
        default: return Anomaly(q);
    }
}

float Cloud(float3 q, float amount)
{
    if (amount <= 0) return 0;
    float cl = Fbm(1, q * 2.4f, 6, 200) + Fbm(1, q * 8, 3, 300) * 0.3f;
    float thr = 0.55f - amount * 0.6f;
    return saturate((cl - thr + 0.15f) * 3.5f) * 0.9f;
}

/// Точка сферы по координатам развёртки (PlanetBaker.Direction).
float3 Direction(float u, float v)
{
    float lon = u * 2 * PI - PI;
    float lat = (v - 0.5f) * PI;
    float c = cos(lat);
    return float3(c * cos(lon), sin(lat), c * sin(lon));
}

[numthreads(8, 8, 1)]
void Surface(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;
    float3 q = Direction((id.x + 0.5f) / _Width, (id.y + 0.5f) / _Height);
    Sample s = Evaluate(q);
    _Heights[id.y * _Width + id.x] = s.Height;
    _Albedo[id.xy] = float4(s.Color, saturate(s.Spec));
    _Emission[id.xy] = float4(s.Glow, 1);
    _Clouds[id.xy] = float4(1, 1, 1, Cloud(q, _CloudAmount));
}

[numthreads(8, 8, 1)]
void Normals(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _Width || (int)id.y >= _Height) return;
    int x = id.x, y = id.y;
    float bump = _Smooth != 0 ? 0 : 1;
    float dLon = 2 * PI / _Width, dLat = PI / _Height;
    float lat = ((y + 0.5f) / _Height - 0.5f) * PI;
    float sinLat = sin(lat), cosLat = cos(lat);
    // Шаг на восток короче у полюсов; совсем у полюса не даём ему стать нулём.
    float eastStep = 2 * dLon * max(cosLat, 0.02f);
    int north = min(y + 1, _Height - 1), south = max(y - 1, 0);
    float northStep = (north - south) * dLat;
    float lon = (x + 0.5f) / _Width * 2 * PI - PI;
    float sinLon = sin(lon), cosLon = cos(lon);
    float3 q = float3(cosLat * cosLon, sinLat, cosLat * sinLon);
    float3 east = float3(-sinLon, 0, cosLon);
    float3 up = float3(-sinLat * cosLon, cosLat, -sinLat * sinLon);
    int row = y * _Width;
    float dEast = (_Heights[row + (x + 1) % _Width] - _Heights[row + (x + _Width - 1) % _Width]) / eastStep;
    float dNorth = (_Heights[north * _Width + x] - _Heights[south * _Width + x]) / northStep;
    float3 nrm = normalize(q - bump * (dEast * east + dNorth * up));
    _Normal[id.xy] = float4(nrm * 0.5f + 0.5f, 1);
}
